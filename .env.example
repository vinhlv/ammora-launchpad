# Ammora launchpad configuration. Copy to .env and never commit .env.
#
# Generation and deployment selection. Config IDs, Registry and Factory are
# generation-specific: do not mix `legacy` and `auto-route` values.
AMMORA_CHAIN_ID=91342
AMMORA_GIWA_GENERATION=auto-route

# Optional RPC override; defaults to the reviewed catalog's public endpoint.
AMMORA_RPC_URL=

# Serialize public RPC reads (milliseconds between JSON-RPC calls).
AMMORA_RPC_INTERVAL_MS=600

# Send gate. Every signing command refuses to run unless this is exactly "1".
# Leave 0 while reviewing previews and unsigned plans.
AMMORA_SEND=0

# Optional transaction hash: bind dependent reads to that successful receipt's
# canonical block (useful right after a creation, while RPC replicas lag).
AMMORA_READ_RECEIPT=

# Public caller address used by unsigned previews and read-only fee views.
AMMORA_ACCOUNT=

# Signing key for send commands only. Keep it out of source control.
AMMORA_PRIVATE_KEY=

# Slippage for curve trades, in basis points (100 = 1%). Max 1000 for ALC curve.
AMMORA_SLIPPAGE_BPS=100

# Optional lifecycle state file (records configId, token, curve, canonicalPool).
AMMORA_STATE_FILE=.ammora-launchpad-state.json
